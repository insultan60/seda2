# Copy to .env.local for local development, and set the same values in the
# hosting environment (Vercel: Project Settings → Environment Variables).
#
# Nothing here is secret in the repo — .env* is gitignored. These are the names
# the app looks for.

# ---------------------------------------------------------------------------
# Production domain. Absolute URLs in the sitemap, canonical tags and social
# link previews are built from this. If it is wrong, Google indexes the wrong
# domain and every shared link previews against it.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://alexandrakerr.com

# ---------------------------------------------------------------------------
# Lead delivery. Without these, the contact / valuation / newsletter forms
# cannot send: they will tell the visitor the send failed and give them
# Alexandra's phone number instead, and write the full lead to the server log
# so it can still be recovered. Nothing is lost — but nothing is delivered
# either, so set these before launch.
#
#   RESEND_API_KEY   from resend.com (free tier covers this volume)
#   LEAD_TO_EMAIL    where enquiries land
#   LEAD_FROM_EMAIL  a sender on a domain verified with Resend. This CANNOT be
#                    a gmail.com or compass.com address — the provider will
#                    reject it. Verify the site's own domain and send from
#                    something like notifications@alexandrakerr.com
# ---------------------------------------------------------------------------
RESEND_API_KEY=
LEAD_TO_EMAIL=alexandra.kerr@compass.com
LEAD_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Live MLS listings (IDX Broker: Home > Access Control > API Key). Server-side
# only. Without it the site shows just the hand-entered listings in
# app/properties/data.ts.
# ---------------------------------------------------------------------------
IDX_BROKER_ACCESS_KEY=
